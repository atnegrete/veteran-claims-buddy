rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin SDK writes this from confirmAuthState. A client must not set it.
    // Later user rules must not use a recursive match that also covers this path.
    match /users/{uid}/security/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
