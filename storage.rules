rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/security/authState).data.mfaEnrollmentConfirmed == true;
    }

    function allowedFile() {
      return request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    match /users/{uid}/documents/{documentId}/{fileName} {
      allow read: if signedInOwner(uid);
      allow create, update: if signedInOwner(uid)
        && allowedFile()
        && (
          (fileName == 'original.pdf' && request.resource.contentType == 'application/pdf')
          || (fileName == 'original.jpg' && request.resource.contentType == 'image/jpeg')
          || (fileName == 'original.png' && request.resource.contentType == 'image/png')
        );
      allow delete: if signedInOwner(uid);
    }

    // Veteran-specific generated form PDFs. The owner may read them; only
    // backend tooling (privileged credentials) writes them (handoff 37.5).
    match /users/{uid}/generatedForms/{generatedFormId}/{fileName} {
      allow read: if signedInOwner(uid);
      allow write: if false;
    }

    // Disposable, watermarked form previews rendered by the previewForm
    // callable. The owner may read them; only the backend writes them.
    match /users/{uid}/formPreviews/{fileName} {
      allow read: if signedInOwner(uid);
      allow write: if false;
    }

    // The authoritative VA reference templates are backend-only. No client
    // read or write (handoff 37.5).
    match /reference/va-forms/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
