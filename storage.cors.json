[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "User-Agent",
      "x-goog-resumable",
      "x-firebase-storage-version",
      "x-client-data",
      "x-firebase-gmpid",
      "x-firebase-appcheck"
    ],
    "maxAgeSeconds": 3600
  }
]
