{
  "name": "veteran-claims-buddy",
  "private": true,
  "scripts": {
    "dev:verify": "node scripts/verify.js",
    "dev:reset-user": "node scripts/reset_user.js",
    "dev:clear-questionnaire": "node scripts/clear_dev_questionnaire.js --confirm-dev-reset",
    "test:scripts": "node --test scripts/dev_project.test.js scripts/publish_questionnaire.test.js scripts/publish_knowledge.test.js scripts/publish_commerce_config.test.js scripts/va_forms.test.js scripts/va_forms_mappings.test.js scripts/seed_scenarios.test.js marketing-site/calculator.test.js marketing-site/site.test.js",
    "test": "npm run test:scripts && npm run dev:verify",
    "dev:seed": "node scripts/seed.js",
    "dev:reset-and-seed": "node scripts/seed.js --replace",
    "build:marketing:css": "tailwindcss -i marketing-site/styles/input.css -o marketing-site/css/site.css --minify",
    "build:marketing": "node marketing-site/build.js && npm run build:marketing:css",
    "build:marketing:dev": "SITE_URL=https://veteran-claims-buddy-dev.web.app APP_URL=https://veteran-claims-buddy-dev-app.web.app node marketing-site/build.js && npm run build:marketing:css",
    "build:app:dev": "cd app && fvm flutter build web --dart-define=APP_ENV=dev",
    "build:app:prod": "cd app && fvm flutter build web --dart-define=APP_ENV=prod",
    "deploy:marketing:dev": "npx -y firebase-tools@latest deploy --only hosting:marketing --project dev",
    "deploy:marketing:prod": "npx -y firebase-tools@latest deploy --only hosting:marketing --project prod",
    "deploy:app:dev": "npx -y firebase-tools@latest deploy --only hosting:app --project dev",
    "deploy:app:prod": "npx -y firebase-tools@latest deploy --only hosting:app --project prod",
    "deploy:hosting:dev": "npx -y firebase-tools@latest deploy --only hosting --project dev",
    "deploy:hosting:prod": "npx -y firebase-tools@latest deploy --only hosting --project prod",
    "build:deploy:marketing:dev": "npm run build:marketing:dev && npm run deploy:marketing:dev",
    "build:deploy:marketing:prod": "npm run build:marketing && npm run deploy:marketing:prod",
    "build:deploy:app:dev": "npm run build:app:dev && npm run deploy:app:dev",
    "build:deploy:app:prod": "npm run build:app:prod && npm run deploy:app:prod",
    "build:deploy:hosting:dev": "npm run build:marketing:dev && npm run build:app:dev && npm run deploy:hosting:dev",
    "build:deploy:hosting:prod": "npm run build:marketing && npm run build:app:prod && npm run deploy:hosting:prod",
    "publish-questionnaire:dev": "node scripts/publish_questionnaire.js --project dev --file questionnaires/condition-discovery-v2.json",
    "publish-questionnaire:prod": "node scripts/publish_questionnaire.js --project prod --file questionnaires/condition-discovery-v2.json --confirm-prod",
    "publish-knowledge:dev": "node scripts/publish_knowledge.js --project dev --file knowledge/va-rules.json",
    "publish-knowledge:prod": "node scripts/publish_knowledge.js --project prod --file knowledge/va-rules.json --confirm-prod",
    "publish-commerce-config:dev": "node scripts/publish_commerce_config.js --project dev --file commerce/commerce-config.json",
    "publish-commerce-config:prod": "node scripts/publish_commerce_config.js --project prod --file commerce/commerce-config.json --confirm-prod",
    "va:forms:discover:dev": "node scripts/va_forms_discover.js --project dev",
    "va:forms:discover:dev:sandbox": "node scripts/va_forms_discover.js --project dev --sandbox",
    "va:forms:discover:prod": "node scripts/va_forms_discover.js --project prod",
    "va:forms:import:dev": "node scripts/va_forms_import.js --project dev",
    "va:forms:import:dev:sandbox": "node scripts/va_forms_import.js --project dev --sandbox",
    "va:forms:import:prod": "node scripts/va_forms_import.js --project prod",
    "va:forms:inspect": "node scripts/va_forms_inspect.js",
    "va:forms:cache": "NODE_PATH=functions/node_modules node scripts/va_forms_cache.js --project dev --sandbox",
    "va:forms:automap": "node scripts/va_forms_automap.js",
    "va:forms:fillcheck": "NODE_PATH=functions/node_modules node scripts/va_forms_fillcheck.js",
    "va:forms:publish-mappings:dev": "node scripts/va_forms_publish_mappings.js --project dev",
    "va:forms:publish-mappings:prod": "node scripts/va_forms_publish_mappings.js --project prod --confirm-prod"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
